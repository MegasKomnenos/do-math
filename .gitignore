node_modules/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
*.pyo

.claude/settings.local.json

# 외부 서비스 로그인 크리덴셜. 저장소·런 디렉토리에 싣지 않는다.
/.credentials/

# Claude Code가 남기는 API 요청·응답 로그. 머신별 산출물이므로 추적하지 않는다.
/logs/

.vscode
.playwright-mcp/

# do-math 연구 인스턴스와 로컬 실행 기반.
.skill-workspace/

# 세션별 작문 실행 상태와 독해 원문.
/.codex/writing-flow/

# 원시 검토 실행 출력.
/.codex/reviews/

# 일반적인 빌드 산출물.
/build/

# 임시/ 아래 작업 디렉터리의 내용은 기본으로 무시한다. 보존할 증거는 `git add -f`로 추적한다.
# 이미 추적된 파일은 이 규칙의 영향을 받지 않는다. 디렉터리가 아니라 내용을 무시해야 아래 부정 규칙이 작동한다.
# verify-rounds 런이 라운드 커밋에서 일반 `git add`로 올리는 세 파일은 추적을 허용한다.
/임시/*/*
!/임시/*/동결.md
!/임시/*/장부.md
!/임시/*/종료보고.md

# do-math graphify local graph, semantic cache, and execution records.
/.claude/graphify/
