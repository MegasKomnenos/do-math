'Parking.P' depends on axioms: [propext, Classical.choice, Quot.sound]
def Parking.P : Prop :=
∀ (n : ℕ) (hn : 1 ≤ n), ∃ c, UnimodalAt ⟨n, hn⟩ c
def Parking.UnimodalAt : ℕ+ → ℕ → Prop :=
fun n c => c < ↑n ∧ (∀ k < c, b n k ≤ b n (k + 1)) ∧ ∀ (k : ℕ), c ≤ k → k < ↑n - 1 → b n (k + 1) ≤ b n k
