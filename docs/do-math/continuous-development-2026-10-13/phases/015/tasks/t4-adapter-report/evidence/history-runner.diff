+def _whole_module_costs(totals, discovered, selected, rows):
+    """A partial selection reports its own cost but cannot replace a full module estimate."""
+    population, chosen = defaultdict(set), defaultdict(set)
+    for test in discovered:
+        population[module_of(test)].add(test.id())
+    for test in selected:
+        chosen[module_of(test)].add(test.id())
+    finished = {row['id'] for row in rows if not row.get('fixture')
+                and row['outcome'] not in {'running', 'not_run'}}
+    return {module: seconds for module, seconds in totals.items()
+            if module in chosen and chosen[module] == population[module]
+            and chosen[module] <= finished}
