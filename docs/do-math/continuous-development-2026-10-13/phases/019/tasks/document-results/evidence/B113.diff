+                continue
+            if token.endswith(('.py', '.json', '.md', '.txt', '.jsonl', '.exe')):
+                continue  # Filename classification does not prove file existence.
+            root = token.split('.')[0]
+            if root not in local and root not in {'contract_check', 'integration'}:
+                pending.add(token)
+    return sorted(pending)
