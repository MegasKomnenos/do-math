+            case.assertIn('report', row)
+            case.assertEqual({k: v for k, v in row.items() if k != 'output_files'},
+                             {k: v for k, v in stored.items() if k != 'output_files'})
+            for excluded in ('knowledge', 'relations', 'integration_bundles'):
