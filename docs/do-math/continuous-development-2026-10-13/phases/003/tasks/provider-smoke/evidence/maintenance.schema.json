{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-contract-id": "do-math-cli/5",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "used_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "report": {
      "type": "string"
    },
    "remaining_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integration_bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "integration_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "impact_set": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "authority_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "previous_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "integration_id",
          "members",
          "impact_set",
          "authority_refs"
        ]
      },
      "description": "Omit this field for one atomic whole-response bundle when there are no existing-object revisions or partial acceptances to preserve. For explicit grouping, declare every state-changing member exactly once. Existing revisions and partial retries require explicit grouping. For ordinary research, 'output' owns the report/outcome/questions, and 'output/knowledge/N' and 'output/relations/N' own records. Extensions use 'activity-extensions.json/FAMILY/N'. Other roles, review research and declared revision work require one bundle with 'output' and all extension members. New-object dependencies must stay in one bundle. Independence is the producer's semantic responsibility. On a retry with central accepted_response evidence, preserve that base response and omit its already accepted member."
    },
    "repair_responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "resolved",
              "maintained",
              "withdrawn"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "issue_id",
          "disposition",
          "reason"
        ]
      }
    }
  },
  "required": [
    "summary",
    "used_sources",
    "questions",
    "report",
    "remaining_work"
  ],
  "$id": "https://do-math.invalid/schemas/cli/5/sha256/db5e32f8d13d467437aad2a69994e5d2cdabe79232612b44a59a5f6e66873138"
}
