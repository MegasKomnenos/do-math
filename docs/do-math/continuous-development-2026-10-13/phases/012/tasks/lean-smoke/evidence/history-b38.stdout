diff --git a/.claude/skills/do-math/scripts/do_math/git_process.py b/.claude/skills/do-math/scripts/do_math/git_process.py
index 781d206d..555b47b1 100644
--- a/.claude/skills/do-math/scripts/do_math/git_process.py
+++ b/.claude/skills/do-math/scripts/do_math/git_process.py
@@ -1,5 +1,7 @@
-"""Real Git backend port: the git executable, isolated from user configuration and hooks.
+"""Real Git backend port: the git executable with each caller's original environment contract.
 
+Storage is isolated from user configuration and hooks; project reads use the
+injected environment; CLI prerequisites inherit the live process environment.
 Objects are written in process as loose objects, the form Git itself writes;
 the git executable reads them back.
 """
@@ -11,8 +13,10 @@ import subprocess
 import tempfile
 import zlib
 
-from .ports.git_backend import GitBackendError
-from .storage_finish_git_output import parse_object_info, parse_read_objects
+from .ports.git_backend import GitBackendError, ProjectSnapshot
+from .storage_finish_git_output import (parse_object_info, parse_read_objects,
+    parse_project_root, parse_project_tree, parse_project_paths)
+from .lean_evidence import check_stop
 
 
 class GitProcess:
@@ -22,6 +26,46 @@ class GitProcess:
         self._git_dirs = {}
         self._objects = {}
 
+    def initialize_repository(self, repository: Path) -> bool:
+        # CLI historically inherited the live environment, unlike both storage
+        # and project reads. Preserve that contract, including Git init defaults.
+        result = self._run_process(['git', '-C', str(repository), 'init', '-q'],
+            check=False, capture_output=True,
+            creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
+        return not result.returncode
+
+    def repository_exists(self, repository: Path) -> bool:
+        result = self._run_process(['git', '-C', str(repository), 'rev-parse', '--git-dir'],
+            check=False, capture_output=True,
+            creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
+        return not result.returncode
+
+    def _project_read(self, root, *arguments, should_stop):
+        # Preserve formal's project Git invocation, including ambient Git config.
+        # State-storage _run deliberately has a different isolation contract.
+        check_stop(should_stop)
+        result = self._run_process(['git', '-C', str(root), *arguments],
+            stdin=subprocess.DEVNULL, capture_output=True, env=self.environment,
+            creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
+        check_stop(should_stop)
+        return result
+
+    def project_repository_root(self, project_root: Path, *, should_stop=None) -> Path | None:
+        result = self._project_read(project_root, 'rev-parse', '--show-toplevel', should_stop=should_stop)
+        return parse_project_root(result.stdout)
+
+    def project_snapshot(self, project_root: Path, repository_root: Path | None, *, should_stop=None) -> ProjectSnapshot:
+        if repository_root is None:
+            return ProjectSnapshot(None, None, b'', frozenset())
+        relative = '.' if project_root == repository_root else project_root.relative_to(repository_root).as_posix()
+        target = 'HEAD^{tree}' if relative == '.' else f'HEAD:{relative}'
+        result = self._project_read(repository_root, 'rev-parse', '--verify', target, should_stop=should_stop)
+        tree = parse_project_tree(result.returncode, result.stdout)
+        diff = self._project_read(repository_root, 'diff', '--no-ext-diff', 'HEAD', '--', relative,
+                                  should_stop=should_stop).stdout
+        paths = self._project_read(repository_root, 'ls-files', '-z', '--', relative, should_stop=should_stop)
+        return ProjectSnapshot(repository_root, tree, diff, parse_project_paths(paths.returncode, paths.stdout))
+
     def _run(self, repository, *arguments, input=None):
         repository = Path(repository).absolute()
         # Until Git reports its directory, the work tree stands in for it (hooks path).
diff --git a/.claude/skills/do-math/scripts/do_math/ports/git_backend.py b/.claude/skills/do-math/scripts/do_math/ports/git_backend.py
index 836ee3e0..496ca290 100644
--- a/.claude/skills/do-math/scripts/do_math/ports/git_backend.py
+++ b/.claude/skills/do-math/scripts/do_math/ports/git_backend.py
@@ -1,10 +1,12 @@
-"""Git backend port: the repository operations GitStateStore needs, in meaning-sized steps.
+"""Git backend port: CLI prerequisites, project facts, and state storage operations.
 
 The port writes and reads the objects of the state commits and moves the state
-ref. A missing object or path answers None; an unexpected Git
-failure raises ``GitBackendError``.
+ref. For storage, a missing object or path answers None and an unexpected Git
+failure raises ``GitBackendError``. CLI prerequisites instead answer exit-status
+success; project reads have their separately documented failure contracts.
 """
 from pathlib import Path
+from dataclasses import dataclass
 from typing import Protocol
 
 
@@ -12,7 +14,47 @@ class GitBackendError(RuntimeError):
     """Git failed in a way the port does not answer with a value."""
 
 
+@dataclass(frozen=True)
+class ProjectSnapshot:
+    repository_root: Path | None
+    tree_oid: str | None
+    raw_diff: bytes
+    tracked_paths: frozenset[str]
+
+
 class GitBackend(Protocol):
+    def initialize_repository(self, repository: Path) -> bool:
+        """Initialize Git in an existing empty directory; answer only exit-status success.
+
+        The CLI owns missing/empty eligibility and mkdir. Inherit the live process
+        environment (including Git's default object format), not the backend's
+        storage environment. Ignore stdout/stderr, even empty or non-UTF bytes;
+        OS/subprocess exceptions propagate. No storage isolation options apply.
+        """
+
+    def repository_exists(self, repository: Path) -> bool:
+        """Can Git resolve --git-dir here? Exit status alone, no output parsing.
+
+        Includes enclosing repositories, bare repositories and linked worktrees.
+        Same ambient environment and exception contract as initialize_repository.
+        Unlike describe, False is a normal answer and no object format is read.
+        """
+
+    def project_repository_root(self, project_root: Path, *, should_stop=None) -> Path | None:
+        """Find the enclosing worktree; empty stdout means None, irrespective of exit status.
+
+        UTF-8 decoding and OS errors propagate. Honour stop before/after the read.
+        """
+
+    def project_snapshot(self, project_root: Path, repository_root: Path | None, *, should_stop=None) -> ProjectSnapshot:
+        """Read HEAD subtree, raw worktree diff and index paths for this project.
+
+        None root means no Git facts. Missing HEAD/subtree gives tree_oid=None;
+        diff stdout is kept even on failure. Index failure raises RuntimeError.
+        Paths decode strict UTF-8. An outside project raises ValueError. Stop is
+        checked before/after each of the three local reads, not only the batch.
+        """
+
     def describe(self, repository: Path) -> tuple:
         """(absolute Git directory, object format 'sha1'|'sha256', objects directory as Git names it)."""
 
