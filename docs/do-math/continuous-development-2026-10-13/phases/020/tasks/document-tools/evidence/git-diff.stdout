diff --git "a/.agents/skills/write-for-reader/references/\353\217\205\355\225\264_\352\262\200\355\206\240.md" "b/.agents/skills/write-for-reader/references/\353\217\205\355\225\264_\352\262\200\355\206\240.md"
index 16cc14d2..a7f345dd 100644
--- "a/.agents/skills/write-for-reader/references/\353\217\205\355\225\264_\352\262\200\355\206\240.md"
+++ "b/.agents/skills/write-for-reader/references/\353\217\205\355\225\264_\352\262\200\355\206\240.md"
@@ -29,7 +29,7 @@ python .agents/skills/write-for-reader/scripts/writing_flow.py status
 
 긴 문서의 중심 절을 먼저 검사할 때에는 `read --scope sample`을 사용한다. 같은 원고 파일을 전체 원고로 발전시킨 뒤 `read --scope whole`로 전체를 검사한다. 짧은 독립 문서는 처음부터 전체를 작성해 검사한다.
 
-독해 모델의 기본값은 `gpt-5.6-sol`, 추론 수준은 `high`다. `--model`, `--effort`로 변경할 수 있다. 이 기본값은 모든 분야의 독해 품질을 보장하지 않는다. 해당 과제에서 더 적합한 모델은 실제 독해 결과로 선택한다. `--timeout`은 한 독해 호출의 제한 시간이며 기본 600초다. 시간 초과는 검토 미완료로 기록한다.
+독해 모델의 기본값은 `gpt-6.1-sol`, 추론 수준은 `high`다. `--model`, `--effort`로 변경할 수 있다. 이 기본값은 모든 분야의 독해 품질을 보장하지 않는다. 해당 과제에서 더 적합한 모델은 실제 독해 결과로 선택한다. `--timeout`은 한 독해 호출의 제한 시간이며 기본 600초다. 시간 초과는 검토 미완료로 기록한다.
 
 ## 독해 실행
 
diff --git a/.agents/skills/write-for-reader/scripts/writing_flow.py b/.agents/skills/write-for-reader/scripts/writing_flow.py
index a6fddc57..420b5647 100644
--- a/.agents/skills/write-for-reader/scripts/writing_flow.py
+++ b/.agents/skills/write-for-reader/scripts/writing_flow.py
@@ -250,7 +250,7 @@ class WritingFlow:
             return "합의 대조 결과가 다른 독해 실행에 관한 것임"
         return None
 
-    def read(self, *, scope="whole", model="gpt-5.6-sol", effort="high", timeout=600, codex=None):
+    def read(self, *, scope="whole", model="gpt-6.1-sol", effort="high", timeout=600, codex=None):
         if scope not in {"sample", "whole"} or not math.isfinite(timeout) or timeout <= 0:
             raise WorkflowError("독해 범위와 제한 시간이 잘못됨")
         executable = shutil.which(str(codex or "codex"))
@@ -452,7 +452,7 @@ def main(argv=None):
         begin.add_argument("--" + name, type=Path, required=True)
     read = sub.add_parser("read", help="작성 대화가 없는 별도 Codex로 원고 독해")
     read.add_argument("--scope", choices=("sample", "whole"), default="whole")
-    read.add_argument("--model", default="gpt-5.6-sol")
+    read.add_argument("--model", default="gpt-6.1-sol")
     read.add_argument("--effort", choices=("low", "medium", "high", "xhigh", "max"), default="high")
     read.add_argument("--timeout", type=float, default=600)
     read.add_argument("--codex")
