+                continue
+            root, *parts = token.split('.')
+            if local.get(root) is not WAIT_BOUNDARIES[owner]:
+                continue
+            node = value
+            for part in parts:
+                if not isinstance(node, dict) or part not in node:
+                    issues.append(('actual field', token))
+                    break
+                node = node[part]
