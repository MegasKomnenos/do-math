  "title": "machine-check",
  "type": "object",
  "x-contract-id": "do-math-draft/machine-check/8",
  "x-id-prefix": "MC",
  "x-owner-section": "16.3,19.8",
  "x-storage": "runtime/artifacts/{bundle_id}/checks/{path}.json"
}
