      "minItems": 0,
      "type": "array"
    },
    "resolved": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "rule_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "path",
          "message"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "schema_version": {
      "const": "do-math-draft/machine-check/8"
    },
    "sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
