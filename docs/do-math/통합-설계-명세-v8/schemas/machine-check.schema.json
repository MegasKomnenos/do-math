{
  "$id": "https://do-math.invalid/schemas/draft/8/machine-check",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "failures": {
            "maxItems": 0
          },
          "uninspected_scope": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "dependentRequired": {
        "previous_check_ref": [
          "resolved"
        ],
        "resolved": [
          "previous_check_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "fail"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "failures": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "incomplete"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "uninspected_scope": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "actual_scope": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
