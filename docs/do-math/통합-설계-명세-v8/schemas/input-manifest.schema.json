{
  "$id": "https://do-math.invalid/schemas/draft/8/input-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "activity_kind": {
            "enum": [
              "research_preparation",
              "research_plan"
            ]
          }
        }
      },
      "then": {
        "required": [
          "planning_input"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "activity_kind": {
            "const": "research_preparation"
          }
        },
        "required": [
          "activity_kind"
        ]
      },
      "then": {
        "properties": {
          "planning_input": {
            "required": [
              "actual_preparation_history_window"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activity_kind": {
            "not": {
              "enum": [
                "research_preparation",
                "research_plan"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "planning_input"
              ]
            }
          ]
        }
      }
    }
  ],
  "properties": {
    "activity_kind": {
      "enum": [
        "research_preparation",
        "research_plan",
        "research_work",
        "task_contract_review",
        "identity_review",
        "goal_audit",
        "operational_review",
        "intent_interpretation",
        "supplemental_research",
        "maintenance"
      ],
      "type": "string"
    },
    "authority_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "common_documents": {
      "allOf": [
        {
          "contains": {
            "properties": {
              "path": {
                "pattern": "(?:^|/)SKILL\\.md$"
              }
            },
            "required": [
              "path"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "path": {
                "pattern": "(?:^|/)GLOSSARY\\.md$"
              }
            },
            "required": [
              "path"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        }
      ],
      "items": {
        "additionalProperties": false,
        "properties": {
          "media_type": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/path"
          },
          "sha256": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/sha256"
          },
          "size_bytes": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "media_type",
          "size_bytes"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "continuity_broken": {
      "type": "boolean"
    },
    "continuity_failure_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "failure_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "governance_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id"
        },
        {
          "pattern": "^IM-"
        }
      ]
    },
    "max_input_tokens": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "output_schema_id": {
      "minLength": 1,
      "type": "string"
    },
    "planning_input": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "canon_exposure": {
                "const": "partial"
              }
            },
            "required": [
              "canon_exposure"
            ]
          },
          "then": {
            "required": [
              "partial_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "canon_exposure": {
                "const": "full"
              }
            },
            "required": [
              "canon_exposure"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "partial_reason"
                  ]
                }
              ]
            }
          }
        }
      ],
      "properties": {
        "actual_history_window": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "actual_preparation_history_window": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "candidate_listing": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "hmac-sort-v1"
            },
            "items": {
              "items": {
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "review_status": {
                          "const": "absent"
                        }
                      },
                      "required": [
                        "review_status"
                      ]
                    },
                    "then": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "review_ref"
                            ]
                          }
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "review_status": {
                          "enum": [
                            "approved",
                            "revision_required",
                            "unresolved"
                          ]
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "review_ref"
                      ]
                    }
                  }
                ],
                "properties": {
                  "author_execution_ids": {
                    "items": {
                      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id_E"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "basis_refs": {
                    "items": {
                      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "description": {
                    "minLength": 1,
                    "pattern": "^[^\\r\\n]+$",
                    "type": "string"
                  },
                  "id": {
                    "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id_T"
                  },
                  "record_ref": {
                    "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
                  },
                  "review_ref": {
                    "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
                  },
                  "review_status": {
                    "enum": [
                      "absent",
                      "approved",
                      "revision_required",
                      "unresolved"
                    ],
                    "type": "string"
                  },
                  "revision": {
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "title": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "work_class": {
                    "enum": [
                      "research_production",
                      "academic_validation"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "record_ref",
                  "revision",
                  "title",
                  "work_class",
                  "basis_refs",
                  "review_status",
                  "author_execution_ids"
                ],
                "type": "object"
              },
              "minItems": 0,
              "type": "array"
            },
            "loaded_count": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "omitted_query": {
              "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/query_scope"
            },
            "scope": {
              "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/query_scope"
            },
            "shuffle_seed": {
              "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/sha256"
            },
            "snapshot_commit": {
              "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/oid"
            },
            "total_count": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "snapshot_commit",
            "scope",
            "total_count",
            "loaded_count",
            "truncated",
            "items",
            "shuffle_seed",
            "algorithm",
            "omitted_query"
          ],
          "type": "object"
        },
        "canon_exposure": {
          "enum": [
            "full",
            "partial"
          ],
          "type": "string"
        },
        "canon_listing": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "hmac-sort-v1"
            },
            "items": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "change_refs": {
                    "items": {
                      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
                    },
                    "minItems": 0,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "declaration_kind": {
                    "enum": [
                      "definition",
                      "theorem",
                      "proof",
                      "relation"
                    ],
                    "type": "string"
                  },
                  "declaration_names": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "explanation_links": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "assessment_ref": {
                          "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
                        },
                        "assessment_value": {
                          "enum": [
                            "match",
                            "mismatch",
                            "unresolved"
                          ],
                          "type": "string"
                        },
                        "explanation_ref": {
                          "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
                        },
                        "use_ref": {
                          "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
                        },
                        "use_state": {
                          "enum": [
                            "active",
                            "suspended",
                            "withdrawn"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "explanation_ref",
                        "assessment_ref",
                        "use_ref",
                        "use_state",
                        "assessment_value"
                      ],
                      "type": "object"
                    },
                    "minItems": 0,
                    "type": "array"
                  },
                  "id": {
                    "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id_K"
                  },
                  "record_ref": {
                    "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
                  },
                  "valid_explanation_available": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "record_ref",
                  "declaration_kind",
                  "declaration_names",
                  "explanation_links",
                  "valid_explanation_available",
                  "change_refs"
                ],
                "type": "object"
              },
              "minItems": 0,
              "type": "array"
            },
            "loaded_count": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "omitted_query": {
              "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/query_scope"
            },
            "scope": {
              "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/query_scope"
            },
            "shuffle_seed": {
              "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/sha256"
            },
            "snapshot_commit": {
              "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/oid"
            },
            "total_count": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "snapshot_commit",
            "scope",
            "total_count",
            "loaded_count",
            "truncated",
            "items",
            "shuffle_seed",
            "algorithm",
            "omitted_query"
          ],
          "type": "object"
        },
        "component_tokens": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "component": {
                "minLength": 1,
                "type": "string"
              },
              "tokens": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "component",
              "tokens"
            ],
            "type": "object"
          },
          "minItems": 0,
          "type": "array"
        },
        "configured_history_window": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "full_canon_tokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "ongoing_refs": {
          "items": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "partial_reason": {
          "minLength": 1,
          "type": "string"
        },
        "preparation_history": {
          "items": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "recent_history": {
          "items": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "required_failure_refs": {
          "items": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "candidate_listing",
        "canon_listing",
        "ongoing_refs",
        "recent_history",
        "preparation_history",
        "required_failure_refs",
        "configured_history_window",
        "actual_history_window",
        "canon_exposure",
        "full_canon_tokens",
        "component_tokens"
      ],
      "type": "object"
    },
    "profile_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
    },
    "provided_order": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "question": {
      "minLength": 1,
      "type": "string"
    },
    "read_scope": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/query_scope"
      },
      "minItems": 0,
      "type": "array"
    },
    "required_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "role_documents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "media_type": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/path"
          },
          "sha256": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/sha256"
          },
          "size_bytes": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "media_type",
          "size_bytes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "do-math-draft/input-manifest/8"
    },
    "scope": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "description",
          "evidence_refs"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "snapshot_commit": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/oid"
    },
    "token_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "transcript": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content_ref": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/artifact_ref"
          },
          "execution_id": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id_E"
          },
          "role": {
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ],
            "type": "string"
          },
          "sequence": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "sequence",
          "role",
          "content_ref",
          "execution_id"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "transcript_complete": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "id",
    "snapshot_commit",
    "question",
    "scope",
    "output_schema_id",
    "profile_ref",
    "authority_refs",
    "common_documents",
    "role_documents",
    "governance_refs",
    "required_refs",
    "failure_refs",
    "read_scope",
    "provided_order",
    "token_count",
    "max_input_tokens",
    "activity_kind"
  ],
  "title": "input-manifest",
  "type": "object",
  "x-contract-id": "do-math-draft/input-manifest/8",
  "x-id-prefix": "IM",
  "x-owner-section": "8,13.1,16.5,19.5",
  "x-storage": "runtime/artifacts/{bundle_id}/input-manifest.json"
}
