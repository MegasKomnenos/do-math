{
  "$id": "https://do-math.invalid/schemas/draft/8/external-action",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "evidence_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "prepared_at": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/instant"
          }
        },
        "required": [
          "attempt",
          "prepared_at",
          "evidence_refs"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "authority_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "execution_id": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id_E"
    },
    "external_identifier": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id"
        },
        {
          "pattern": "^EA-"
        }
      ]
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "next_owner": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id"
        },
        "kind": {
          "enum": [
            "instance",
            "task",
            "activity"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "reobserve": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/wake"
    },
    "request_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/artifact_ref"
    },
    "request_sha256": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/sha256"
    },
    "retry_rule_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
    },
    "schema_version": {
      "const": "do-math-draft/external-action/8"
    },
    "state": {
      "enum": [
        "prepared",
        "confirmed",
        "failed",
        "unknown",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "execution_id",
    "authority_refs",
    "request_ref",
    "request_sha256",
    "state",
    "attempts",
    "evidence_refs",
    "retry_rule_ref",
    "next_owner"
  ],
  "title": "external-action",
  "type": "object",
  "x-contract-id": "do-math-draft/external-action/8",
  "x-id-prefix": "EA",
  "x-owner-section": "13.3,19.4",
  "x-storage": "runtime/actions/{id}.json"
}
