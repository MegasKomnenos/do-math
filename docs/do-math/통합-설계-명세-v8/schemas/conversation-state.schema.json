{
  "$id": "https://do-math.invalid/schemas/draft/8/conversation-state",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "policy": {
            "const": "pause"
          }
        },
        "required": [
          "policy"
        ]
      },
      "then": {
        "required": [
          "heartbeat_interval",
          "loss_grace"
        ]
      }
    }
  ],
  "properties": {
    "connection_generation": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "event_ids": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id_EVT"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "heartbeat_interval": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/duration"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id"
        },
        {
          "pattern": "^CV-"
        }
      ]
    },
    "last_heartbeat_at": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/instant"
    },
    "loss_grace": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/duration"
    },
    "observed_at": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/instant"
    },
    "policy": {
      "enum": [
        "pause",
        "continue_authorized"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "do-math-draft/conversation-state/8"
    },
    "state": {
      "enum": [
        "connected",
        "disconnected",
        "lost"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "connection_generation",
    "policy",
    "state",
    "observed_at",
    "event_ids",
    "evidence_refs"
  ],
  "title": "conversation-state",
  "type": "object",
  "x-contract-id": "do-math-draft/conversation-state/8",
  "x-id-prefix": "CV",
  "x-owner-section": "3.3,19.4",
  "x-storage": "runtime/conversations/{id}.json"
}
