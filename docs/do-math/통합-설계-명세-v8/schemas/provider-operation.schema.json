{
  "$id": "https://do-math.invalid/schemas/draft/8/provider-operation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id_EA"
    },
    "evidence_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "execution_id": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id_E"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id"
        },
        {
          "pattern": "^PO-"
        }
      ]
    },
    "next_observation": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/wake"
    },
    "observation": {
      "enum": [
        "not_sent",
        "running",
        "ended",
        "unknown",
        "unrecoverable"
      ],
      "type": "string"
    },
    "observed_at": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/instant"
    },
    "profile_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
    },
    "provider_identifier": {
      "minLength": 1,
      "type": "string"
    },
    "request_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/artifact_ref"
    },
    "reservation_ids": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id_RR"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "do-math-draft/provider-operation/8"
    }
  },
  "required": [
    "schema_version",
    "id",
    "execution_id",
    "request_ref",
    "profile_ref",
    "action_id",
    "reservation_ids",
    "observation",
    "evidence_refs",
    "observed_at"
  ],
  "title": "provider-operation",
  "type": "object",
  "x-contract-id": "do-math-draft/provider-operation/8",
  "x-id-prefix": "PO",
  "x-owner-section": "4.2,6.1,13.3,19.4",
  "x-storage": "runtime/provider-operations/{id}/record.json"
}
