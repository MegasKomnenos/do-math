{
  "$id": "https://do-math.invalid/schemas/draft/8/runtime",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "paused"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "required": [
          "resume_lifecycle"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "enum": [
              "initializing",
              "active"
            ]
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "resume_lifecycle"
              ]
            }
          ]
        }
      }
    }
  ],
  "properties": {
    "engine_id": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id_EN"
    },
    "event_cursor": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id"
        },
        {
          "pattern": "^RT-"
        }
      ]
    },
    "lifecycle": {
      "enum": [
        "initializing",
        "active",
        "paused"
      ],
      "type": "string"
    },
    "next_research_reconsider_at": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/instant"
    },
    "open_plan_id": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id"
    },
    "open_preparation_id": {
      "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id"
    },
    "pending_event_ids": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id_EVT"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "preparation_cursor": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "recovery_evidence_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "recovery_status": {
      "enum": [
        "checking",
        "ready",
        "blocked"
      ],
      "type": "string"
    },
    "resume_lifecycle": {
      "enum": [
        "initializing",
        "active"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "do-math-draft/runtime/8"
    },
    "selection_cursor": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "threshold_holds": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "basis_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/exact_ref"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "decision_question_ref": {
            "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/artifact_ref"
          },
          "kind": {
            "enum": [
              "import_rework",
              "selection_failure",
              "exhaustion_empty",
              "proposal_version"
            ],
            "type": "string"
          },
          "owner": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "https://do-math.invalid/schemas/draft/8/common#/$defs/id"
              },
              "kind": {
                "enum": [
                  "instance",
                  "task",
                  "activity"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          }
        },
        "required": [
          "kind",
          "owner",
          "basis_refs",
          "decision_question_ref"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "engine_id",
    "lifecycle",
    "recovery_status",
    "recovery_evidence_refs",
    "event_cursor",
    "preparation_cursor",
    "selection_cursor",
    "pending_event_ids",
    "threshold_holds"
  ],
  "title": "runtime",
  "type": "object",
  "x-contract-id": "do-math-draft/runtime/8",
  "x-id-prefix": "RT",
  "x-owner-section": "3.1,9.1,13.5,14.2,19.2",
  "x-storage": "runtime/state.json"
}
