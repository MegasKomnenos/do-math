    "occurrence_condition": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "always"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "args": {
              "items": {
                "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/occurrence_condition"
              },
              "minItems": 1,
              "type": "array"
            },
            "op": {
              "enum": [
                "all",
                "any"
              ],
              "type": "string"
            }
          },
          "required": [
            "op",
            "args"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "arg": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/occurrence_condition"
            },
            "op": {
              "const": "not"
            }
          },
          "required": [
            "op",
            "arg"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "family": {
              "minLength": 1,
              "type": "string"
            },
            "op": {
              "const": "record_exists"
            },
            "record_id": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
            },
            "space": {
              "enum": [
                "research",
                "runtime"
              ],
              "type": "string"
            }
          },
          "required": [
            "op",
            "space",
            "record_id",
            "family"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "record_lifecycle_is"
            },
            "record_id": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
            },
            "space": {
              "enum": [
                "research",
                "runtime"
              ],
              "type": "string"
            },
            "value": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "op",
            "space",
            "record_id",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "record_field_equals"
            },
            "pointer": {
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
              "type": "string"
            },
            "record_id": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
            },
            "space": {
              "enum": [
                "research",
                "runtime"
              ],
              "type": "string"
            },
            "value": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/scalar"
            }
          },
          "required": [
            "op",
            "space",
            "record_id",
            "pointer",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from_id": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
            },
            "op": {
              "const": "relation_exists"
            },
            "subkind": {
              "minLength": 1,
              "type": "string"
            },
            "to_id": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
            }
          },
          "required": [
            "op",
            "subkind",
            "from_id",
            "to_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "task_disposition_is"
            },
            "task_id": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_T"
            },
            "value": {
              "enum": [
                "completed",
                "closed"
              ],
              "type": "string"
            }
          },
          "required": [
            "op",
            "task_id",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "decision_id": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_DC"
            },
            "op": {
              "const": "decision_value_is"
            },
            "value": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/scalar"
            }
          },
          "required": [
            "op",
            "decision_id",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_ref": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
            },
            "op": {
              "const": "artifact_valid"
            }
          },
          "required": [
            "op",
            "artifact_ref"
          ],
          "type": "object"
        }
      ]
    },
    "oid": {
      "$comment": "Object-format length is checked against the instance, not guessed.",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "optional_wait": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "waiting"
            },
            "wait": {
              "additionalProperties": false,
              "properties": {
                "next_owner": {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
                    },
                    "kind": {
                      "enum": [
                        "instance",
                        "task",
                        "activity"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "id"
                  ],
                  "type": "object"
                },
                "target_refs": {
                  "items": {
                    "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "wait_kind": {
                  "enum": [
                    "user_decision",
                    "research_input",
                    "validation",
                    "external_event",
                    "execution_repair"
                  ],
                  "type": "string"
                },
                "wake": {
                  "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/wake"
                }
              },
              "required": [
                "wait_kind",
                "target_refs",
                "next_owner",
                "wake"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "wait"
          ],
          "type": "object"
        }
      ]
    },
    "path": {
      "format": "do-math-path",
      "minLength": 1,
      "type": "string"
    },
    "prior_hash": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "absent"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
