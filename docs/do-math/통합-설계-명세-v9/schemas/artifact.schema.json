{
  "$id": "https://do-math.invalid/schemas/draft/9/artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/instant"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "media_type": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/path"
          },
          "sha256": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/sha256"
          },
          "size_bytes": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "media_type",
          "size_bytes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
        },
        {
          "pattern": "^AB-"
        }
      ]
    },
    "kind": {
      "enum": [
        "input",
        "output",
        "checkpoint",
        "evidence",
        "transcript"
      ],
      "type": "string"
    },
    "origin_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "producer_execution_id": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_E"
    },
    "schema_version": {
      "const": "do-math-draft/artifact/9"
    },
    "sealed": {
      "const": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "created_at",
    "files",
    "origin_refs",
    "sealed"
  ],
  "title": "artifact",
  "type": "object",
  "x-contract-id": "do-math-draft/artifact/9",
  "x-id-prefix": "AB",
  "x-owner-section": "6.5,7.1,19.2",
  "x-storage": "runtime/artifacts/{id}/manifest.json"
}
