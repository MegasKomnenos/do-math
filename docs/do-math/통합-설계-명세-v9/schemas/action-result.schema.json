{
  "$id": "https://do-math.invalid/schemas/draft/9/action-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "minLength": 1,
      "type": "string"
    },
    "delegation": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "additionalProperties": false,
          "properties": {
            "absence_queries": {
              "items": {
                "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/query_scope"
              },
              "minItems": 0,
              "type": "array"
            },
            "record_refs": {
              "items": {
                "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
              },
              "minItems": 0,
              "type": "array",
              "uniqueItems": true
            },
            "required_effects": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "effect": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "record_ref": {
                    "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
                  }
                },
                "required": [
                  "record_ref",
                  "effect"
                ],
                "type": "object"
              },
              "minItems": 0,
              "type": "array"
            }
          },
          "required": [
            "record_refs",
            "absence_queries",
            "required_effects"
          ],
          "type": "object"
        },
        "case_ref": {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
        },
        "checking_ref": {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
        },
        "effect_ref": {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
        },
        "interpretation_ref": {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
        },
        "permission_ref": {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
        },
        "source_decision_ref": {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
        }
      },
      "required": [
        "permission_ref",
        "source_decision_ref",
        "case_ref",
        "effect_ref",
        "interpretation_ref",
        "checking_ref",
        "basis"
      ],
      "type": "object"
    },
    "followups": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "input_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "kind": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
              },
              "kind": {
                "enum": [
                  "instance",
                  "task",
                  "activity"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "wake": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/wake"
          }
        },
        "required": [
          "kind",
          "owner",
          "input_refs",
          "wake",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
        },
        {
          "pattern": "^AX-"
        }
      ]
    },
    "input_sha256": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/sha256"
    },
    "reason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "message": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "evidence_refs"
      ],
      "type": "object"
    },
    "request_id": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_RQ"
    },
    "result_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "do-math-draft/action-result/9"
    },
    "state": {
      "enum": [
        "prepared",
        "applied",
        "rejected",
        "blocked",
        "failed"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "request_id",
    "input_sha256",
    "command",
    "state",
    "result_refs",
    "reason",
    "followups"
  ],
  "title": "action-result",
  "type": "object",
  "x-contract-id": "do-math-draft/action-result/9",
  "x-id-prefix": "AX",
  "x-owner-section": "3.2.1,10.3,13.2,16.3,19.7",
  "x-storage": "runtime/actions/results/{id}.json"
}
