{
  "$id": "https://do-math.invalid/schemas/draft/9/implementation-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability_evidence_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "codec_profile": {
      "const": "do-math-codec/9"
    },
    "dependencies": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
        },
        {
          "pattern": "^IC-"
        }
      ]
    },
    "implementation_commit": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/oid"
    },
    "okf_profile": {
      "additionalProperties": false,
      "properties": {
        "spec_sha256": {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/sha256"
        },
        "subset_ref": {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
        },
        "version": {
          "const": "0.2"
        }
      },
      "required": [
        "version",
        "spec_sha256",
        "subset_ref"
      ],
      "type": "object"
    },
    "schema_registry_sha256": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/sha256"
    },
    "schema_version": {
      "const": "do-math-draft/implementation-manifest/9"
    },
    "skill_documents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "media_type": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/path"
          },
          "sha256": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/sha256"
          },
          "size_bytes": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "media_type",
          "size_bytes"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "tool_manifest_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    }
  },
  "required": [
    "schema_version",
    "id",
    "implementation_commit",
    "schema_registry_sha256",
    "tool_manifest_ref",
    "skill_documents",
    "codec_profile",
    "dependencies",
    "okf_profile",
    "capability_evidence_refs"
  ],
  "title": "implementation-manifest",
  "type": "object",
  "x-contract-id": "do-math-draft/implementation-manifest/9",
  "x-id-prefix": "IC",
  "x-owner-section": "14.5,16.5,19.1",
  "x-storage": "installed/implementation-manifest.json"
}
