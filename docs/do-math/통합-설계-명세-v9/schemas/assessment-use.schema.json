      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "assessment_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
    },
    "changed_at": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/instant"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
        },
        {
          "pattern": "^AU-"
        }
      ]
    },
    "previous_use_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
    },
    "reason_refs": {
      "items": {
