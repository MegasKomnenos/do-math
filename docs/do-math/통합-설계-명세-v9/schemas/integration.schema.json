  "required": [
    "schema_version",
    "id",
    "base_snapshot_commit",
    "author_execution_ids",
    "changes",
    "authority_refs",
    "assessment_refs",
    "check_refs",
    "impact",
    "followups"
  ],
  "title": "integration",
  "type": "object",
  "x-contract-id": "do-math-draft/integration/9",
  "x-id-prefix": "IN",
  "x-owner-section": "10,19.6",
  "x-storage": "research/integrations/{id}.json"
}
