              "create",
              "revise",
              "withdraw",
              "delete"
            ],
            "type": "string"
          },
          "prior": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/prior_hash"
          },
          "record_id": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
          }
        },
        "required": [
          "operation",
          "record_id",
          "prior",
          "candidate_ref"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "check_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "followups": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "input_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
