          "owner",
          "input_refs",
          "wake",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
        },
        {
          "pattern": "^IN-"
        }
      ]
    },
    "impact": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "approval_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
