{
  "$id": "https://do-math.invalid/schemas/draft/9/integration",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessment_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "author_execution_ids": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_E"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "authority_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "base_snapshot_commit": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/oid"
    },
    "changes": {
      "items": {
        "additionalProperties": false,
