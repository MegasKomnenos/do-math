diff --git a/.agents/skills/do-math/scripts/do_math/planning.py b/.agents/skills/do-math/scripts/do_math/planning.py
index 8db59a7..b003728 100644
--- a/.agents/skills/do-math/scripts/do_math/planning.py
+++ b/.agents/skills/do-math/scripts/do_math/planning.py
@@ -21,6 +21,36 @@ def contract_hash(task: dict) -> str:
     return _hash({key: task[key] for key in CONTRACT_FIELDS if key in task})
 
 
+TERMINAL_TASK_STATUSES = frozenset({"completed", "closed"})
+
+
+def task_reference_basis(task: dict) -> dict:
+    """What a result that only cites a task relied on: its contract, the results it could read and whether it was open.
+
+    Lifecycle bookkeeping (reviews, selection, readiness, open status moves) is excluded; the receiver
+    re-checks every task that a result actually selects, assesses or revises."""
+    results = task.get("results", [])
+    return {"id": task["id"], "contract_sha256": contract_hash(task), "result_count": len(results),
+            "results_sha256": _hash(results), "terminal": task.get("status") in TERMINAL_TASK_STATUSES}
+
+
+def task_reference_changes(basis: list[dict], tasks: dict) -> list[str]:
+    reasons = []
+    for row in basis:
+        task = tasks.get(row["id"])
+        if task is None:
+            reasons.append("missing:" + row["id"])
+            continue
+        if contract_hash(task) != row["contract_sha256"]:
+            reasons.append("contract_changed:" + row["id"])
+        # Results are append-only; later returns do not change what the producer read.
+        if _hash(task.get("results", [])[:row["result_count"]]) != row["results_sha256"]:
+            reasons.append("results_changed:" + row["id"])
+        if task.get("status") in TERMINAL_TASK_STATUSES and not row["terminal"]:
+            reasons.append("task_ended:" + row["id"])
+    return reasons
+
+
 def ready_task_ids(runtime: dict) -> list[str]:
     """The current selection population, shared by producer input and receiver."""
     return sorted(tid for tid, task in runtime.get("tasks", {}).items() if task.get("status") == "ready")
diff --git a/.agents/skills/do-math/scripts/tests/test_currentness_recovery.py b/.agents/skills/do-math/scripts/tests/test_currentness_recovery.py
index 67cdee8..1ef3ce2 100644
--- a/.agents/skills/do-math/scripts/tests/test_currentness_recovery.py
+++ b/.agents/skills/do-math/scripts/tests/test_currentness_recovery.py
@@ -75,6 +75,33 @@ class CurrentnessTests(PurposeHarness):
         entry = next(f for f in execution['output_files'] if f['path'] == 'partial.txt')
         self.assertEqual(engine.store.read(entry['artifact_ref']), b'The old input was read.')
 
+    def _plan_citing_task_while(self, change):
+        engine, runner = self.make()
+        self.drive(engine, predicate=lambda e: e.runtime['queue'] and e.runtime['queue'][0]['role'] == 'research_plan'
+                   and any(t['status'] == 'ready' for t in e.runtime['tasks'].values()))
+        task_id = next(tid for tid, t in engine.runtime['tasks'].items() if t['status'] == 'ready')
+        class ConcurrentChange:
+            def run(inner, **kwargs):
+                result = runner.run(**kwargs)
+                change(engine.runtime['tasks'][task_id])
+                result['output']['used_sources'] = [*result['output'].get('used_sources', []), task_id]
+                return result
+        engine.runner = ConcurrentChange()
+        engine.run(max_steps=1)
+        return engine, task_id, next(e for e in reversed(list(engine.runtime['executions'].values())) if e['role'] == 'research_plan')
+
+    def test_cited_task_lifecycle_change_during_plan_does_not_reject_the_plan(self):
+        engine, task_id, plan = self._plan_citing_task_while(
+            lambda task: task.update(deferred_reason='Concurrent planner note', reviews=[*task['reviews'], {'note': 'concurrent'}]))
+        self.assertEqual(plan['outcome'], 'output_accepted', plan.get('error'))
+        self.assertEqual([row['id'] for row in plan['task_reference_basis']], [task_id])
+        self.assertEqual(engine.runtime['tasks'][task_id]['status'], 'performing')
+
+    def test_cited_task_contract_change_during_plan_rejects_the_plan(self):
+        engine, task_id, plan = self._plan_citing_task_while(lambda task: task.update(scope=task['scope'] + ' (revised)'))
+        self.assertEqual(plan['outcome'], 'execution_incomplete')
+        self.assertIn('a decision dependency changed during execution: contract_changed:' + task_id, plan['error'])
+
     def test_failed_execution_materials_are_restored_for_its_operational_review(self):
         engine, _ = self.make()
         class FailingRunner:
