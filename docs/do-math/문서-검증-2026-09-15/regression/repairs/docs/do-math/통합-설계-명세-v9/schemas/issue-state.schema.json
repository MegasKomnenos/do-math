{
  "$id": "https://do-math.invalid/schemas/draft/9/issue-state",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "continuity_broken": {
            "const": true
          }
        },
        "required": [
          "continuity_broken"
        ]
      },
      "then": {
        "required": [
          "continuity_break_cause"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "continuity_broken": {
            "const": false
          }
        },
        "required": [
          "continuity_broken"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "continuity_break_cause"
              ]
            }
          ]
        }
      }
    }
  ],
  "properties": {
    "continuity_break_cause": {
      "enum": [
        "permanent_loss",
        "context_overflow",
        "profile_replaced"
      ],
      "type": "string"
    },
    "continuity_broken": {
      "type": "boolean"
    },
    "continuity_evidence_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "execution_limit": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "executions_used": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
        },
        {
          "pattern": "^IS-"
        }
      ]
    },
    "issues": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "answer_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "answer_role_slot_id": {
            "minLength": 1,
            "type": "string"
          },
          "author_slot_id": {
            "minLength": 1,
            "type": "string"
          },
          "claim_ref": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
          },
          "coordinates": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "establishment_basis": {
            "enum": [
              "unanimous_approval",
              "none"
            ],
            "type": "string"
          },
          "evidence_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
          },
          "judge_results": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "reason_ref": {
                  "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
                },
                "slot_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "value": {
                  "enum": [
                    "approved",
                    "rejected",
                    "unresolved"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "slot_id",
                "value",
                "reason_ref"
              ],
              "type": "object"
            },
            "minItems": 0,
            "type": "array"
          },
          "lineage_id": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
          },
          "parent_issue_ids": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "revision": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "round": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "source_result_ref": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
          },
          "state": {
            "enum": [
              "open",
              "approved",
              "rejected",
              "withdrawn",
              "unresolved"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "revision",
          "lineage_id",
          "round",
          "author_slot_id",
          "answer_role_slot_id",
          "source_result_ref",
          "claim_ref",
          "coordinates",
          "evidence_refs",
          "parent_issue_ids",
          "answer_refs",
          "judge_results",
          "state",
          "establishment_basis"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "judge_slot_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array",
      "uniqueItems": true
    },
    "previous_proposal_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    },
    "proposal_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    },
    "proposal_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "repair_map_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    },
    "reserved_answer_executions": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "reserved_final_executions": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "reserved_organize_executions": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "review_lineage_id": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_AC"
    },
    "review_plan_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
    },
    "role_slots": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "context_origin_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "perspective": {
            "minLength": 1,
            "type": "string"
          },
          "producer_execution_ids": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_E"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "profile_ref": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
          },
          "scope_item_ids": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "transcript_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "perspective",
          "profile_ref",
          "scope_item_ids",
          "producer_execution_ids",
          "context_origin_refs",
          "transcript_refs"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "do-math-draft/issue-state/9"
    },
    "scope_manifest_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    }
  },
  "required": [
    "schema_version",
    "id",
    "review_lineage_id",
    "proposal_ref",
    "proposal_revision",
    "role_slots",
    "issues",
    "executions_used",
    "execution_limit",
    "reserved_organize_executions",
    "reserved_answer_executions",
    "reserved_final_executions",
    "scope_manifest_ref",
    "continuity_broken",
    "continuity_evidence_refs",
    "judge_slot_ids",
    "review_plan_ref"
  ],
  "title": "issue-state",
  "type": "object",
  "x-contract-id": "do-math-draft/issue-state/9",
  "x-id-prefix": "IS",
  "x-owner-section": "8.3,11.3,11.4,19.6",
  "x-storage": "runtime/activities/{activity_id}/issues/{id}.json"
}
