{
  "$id": "https://do-math.invalid/schemas/draft/9/trust-environment",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "active",
              "superseded"
            ]
          }
        }
      },
      "then": {
        "required": [
          "schema_version",
          "id",
          "state",
          "allowed_axioms",
          "lean_source_ref",
          "lean_binary_ref",
          "toolchain_ref",
          "mathlib_source_ref",
          "mathlib_build_ref",
          "check_tool_refs",
          "reproduction_ref",
          "base_acceptance_ref",
          "result_refs",
          "transition_approval_ref",
          "impact_refs"
        ]
      }
    }
  ],
  "properties": {
    "allowed_axioms": {
      "items": {
        "enum": [
          "propext",
          "Quot.sound",
          "Classical.choice"
        ],
        "type": "string"
      },
      "minItems": 3,
      "type": "array",
      "uniqueItems": true
    },
    "base_acceptance_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
    },
    "check_tool_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
        },
        {
          "pattern": "^TE-"
        }
      ]
    },
    "impact_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "lean_binary_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    },
    "lean_source_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    },
    "mathlib_build_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    },
    "mathlib_source_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    },
    "previous_environment_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
    },
    "reproduction_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    },
    "result_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "do-math-draft/trust-environment/9"
    },
    "state": {
      "enum": [
        "staging",
        "active",
        "superseded",
        "invalidated"
      ],
      "type": "string"
    },
    "toolchain_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    },
    "transition_approval_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
    }
  },
  "required": [
    "schema_version",
    "id",
    "state",
    "allowed_axioms",
    "lean_source_ref",
    "toolchain_ref",
    "mathlib_source_ref",
    "transition_approval_ref",
    "impact_refs",
    "result_refs"
  ],
  "title": "trust-environment",
  "type": "object",
  "x-contract-id": "do-math-draft/trust-environment/9",
  "x-id-prefix": "TE",
  "x-owner-section": "15,19.6",
  "x-storage": "research/trust/{id}.json"
}
