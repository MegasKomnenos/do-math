{
  "$id": "https://do-math.invalid/schemas/draft/9/plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activity_id": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_AC"
    },
    "candidate_dispositions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "information_status": {
            "enum": [
              "evidence",
              "inference",
              "hypothesis",
              "intuition",
              "random"
            ],
            "type": "string"
          },
          "read_scope_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "revision": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "task_id": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_T"
          },
          "uncertainty": {
            "minLength": 1,
            "type": "string"
          },
          "value": {
            "enum": [
              "selected",
              "not_selected",
              "not_assessable"
            ],
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "revision",
          "value",
          "reason",
          "information_status",
          "uncertainty",
          "read_scope_refs"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "completion_assessments": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "consumed_event_ids": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_EVT"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "dispatch_order": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_T"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "execution_id": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_E"
    },
    "execution_requests": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "execution_profile_id": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "revision": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "task_id": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_T"
          }
        },
        "required": [
          "task_id",
          "revision",
          "execution_profile_id",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "expectation_actual_comparison_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    },
    "exploration_consideration": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
        },
        {
          "pattern": "^PN-"
        }
      ]
    },
    "input_manifest_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
    },
    "next_reconsideration": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/wake"
    },
    "parallel_relations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "task_ids": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_T"
            },
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "task_ids",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "preparation_requests": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "queued_cancellations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id_E"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "execution_id",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "schema_version": {
      "const": "do-math-draft/plan/9"
    },
    "snapshot_commit": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/oid"
    },
    "user_decision_requests": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "basis_refs": {
            "items": {
              "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "question_ref": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
          }
        },
        "required": [
          "question_ref",
          "basis_refs"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "activity_id",
    "execution_id",
    "input_manifest_ref",
    "snapshot_commit",
    "candidate_dispositions",
    "execution_requests",
    "dispatch_order",
    "parallel_relations",
    "queued_cancellations",
    "preparation_requests",
    "completion_assessments",
    "user_decision_requests",
    "expectation_actual_comparison_ref",
    "exploration_consideration",
    "next_reconsideration",
    "consumed_event_ids"
  ],
  "title": "plan",
  "type": "object",
  "x-contract-id": "do-math-draft/plan/9",
  "x-id-prefix": "PN",
  "x-owner-section": "9,19.5",
  "x-storage": "runtime/artifacts/{bundle_id}/plan.json"
}
