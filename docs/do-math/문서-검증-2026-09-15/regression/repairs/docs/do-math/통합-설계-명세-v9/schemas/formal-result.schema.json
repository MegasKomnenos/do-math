{
  "$id": "https://do-math.invalid/schemas/draft/9/formal-result",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_state": {
            "const": "accepted"
          }
        },
        "required": [
          "publication_state"
        ]
      },
      "then": {
        "required": [
          "kernel_check_ref",
          "axiom_check_ref",
          "formal_use"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "publication_state": {
            "const": "candidate"
          }
        },
        "required": [
          "publication_state"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "formal_use"
              ]
            }
          ]
        }
      }
    }
  ],
  "properties": {
    "axiom_check_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
    },
    "basis_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "declarations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "minLength": 1,
            "type": "string"
          },
          "body_sha256": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/sha256"
          },
          "kind": {
            "enum": [
              "definition",
              "theorem",
              "proof",
              "relation"
            ],
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "source_ref": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
          },
          "type_sha256": {
            "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/sha256"
          }
        },
        "required": [
          "name",
          "kind",
          "type_sha256",
          "body_sha256",
          "source_ref",
          "anchor"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "dependency_refs": {
      "items": {
        "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "formal_use": {
      "enum": [
        "active",
        "suspended",
        "historical"
      ],
      "type": "string"
    },
    "id": {
      "allOf": [
        {
          "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/id"
        },
        {
          "pattern": "^K-"
        }
      ]
    },
    "kernel_check_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
    },
    "publication_state": {
      "enum": [
        "candidate",
        "accepted"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "do-math-draft/formal-result/9"
    },
    "source_manifest_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/artifact_ref"
    },
    "trust_environment_ref": {
      "$ref": "https://do-math.invalid/schemas/draft/9/common#/$defs/exact_ref"
    }
  },
  "required": [
    "schema_version",
    "id",
    "declarations",
    "dependency_refs",
    "trust_environment_ref",
    "source_manifest_ref",
    "basis_refs",
    "publication_state"
  ],
  "title": "formal-result",
  "type": "object",
  "x-contract-id": "do-math-draft/formal-result/9",
  "x-id-prefix": "K",
  "x-owner-section": "1.2,11.1,11.6,15,19.6",
  "x-storage": "research/formal/results/{id}.json"
}
