{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "understanding": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "line",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "statement",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "difficulties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "line",
          "quote",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "understanding",
    "difficulties",
    "uncertainties"
  ],
  "additionalProperties": false
}
