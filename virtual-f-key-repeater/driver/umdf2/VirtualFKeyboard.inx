;/*++
;
;Copyright (c) Microsoft Corporation All rights Reserved
;
;Module Name:
;
;    VirtualFKeyboard.inf
;
;Abstract:
;    INF file for installing HID minidriver (UMDF 2 version)
;
; Installation Notes:
;    pnputil /add-driver VirtualFKeyboard.inf /install
;
; Important:
;    This INF depends on MsHidUmdf.inf, which was introduced in build 22000
;
;--*/
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ProviderString%
DriverVer=09/05/2026,1.1.0.2
CatalogFile=VirtualFKeyboard.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1=%Disk_Description%,,,

[SourceDisksFiles]
VirtualFKeyboard.dll=1

; ================= Device section =====================

[Manufacturer]
%ManufacturerString%=VirtualFKeyboard, NT$ARCH$.10.0...22000

[VirtualFKeyboard.NT$ARCH$.10.0...22000]
%DeviceDesc%=VirtualFKeyboard, Root\VirtualFKeyboard

[VirtualFKeyboard.NT]
CopyFiles=UMDriverCopy
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT

[VirtualFKeyboard.NT.hw]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.hw
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.hw

[VirtualFKeyboard.NT.Services]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.Services
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Services

[VirtualFKeyboard.NT.Filters]
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Filters

[VirtualFKeyboard.NT.Wdf]
UmdfService="VirtualFKeyboard", VirtualFKeyboard_Install
UmdfServiceOrder=VirtualFKeyboard
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[VirtualFKeyboard_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary="%13%\VirtualFKeyboard.dll"

; ================= copy files =====================

[UMDriverCopy]
VirtualFKeyboard.dll

;---------------------------------------------------------------;

[Strings]
ProviderString     ="Virtual F Keyboard Project"
ManufacturerString ="Virtual F Keyboard Project"
ClassName          ="Human Interface Devices"
Disk_Description   ="Virtual F Keyboard installation disk"
DeviceDesc         ="Virtual F Keyboard"
WudfRdDisplayName  ="Windows Driver Foundation - User-mode Driver Framework Reflector"
