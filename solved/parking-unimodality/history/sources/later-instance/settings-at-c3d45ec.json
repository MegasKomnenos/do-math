{
  "schema": 1,
  "max_sessions": 8,
  "explore_every": 1,
  "organizer_every_records": 4,
  "launch_interval": 180,
  "models": [
    {
      "model": "claude/fable",
      "effort": "max"
    },
    {
      "model": "codex/gpt-6.2-sol",
      "effort": "xhigh"
    }
  ],
  "roles": {
    "peer": [
      {
        "model": "claude/fable",
        "effort": "max"
      },
      {
        "model": "codex/gpt-6.2-sol",
        "effort": "xhigh"
      }
    ],
    "review": [
      {
        "model": "claude/opus",
        "effort": "max"
      }
    ]
  },
  "cli": {
    "codex": "C:/Users/<account>/AppData/Local/Programs/OpenAI/Codex/bin/codex.exe",
    "claude": "C:/Users/<account>/.local/bin/claude.exe"
  },
  "retry_seconds": 60,
  "retry_max_seconds": 1800,
  "mcp_servers": {},
  "max_end_resumptions": 3,
  "lean": {
    "memory_budget_mb": null,
    "confidence": 1.3,
    "min_free_memory_mb": 2048,
    "cpu_threads_budget": null,
    "threads": 2,
    "priority": "below_normal",
    "max_passes": 3,
    "calibration_expect_mb": 2048,
    "default_spread": 0.5,
    "command": [
      "C:/math/.skill-workspace/do-math-toolchains/lean-4.32.0/lean-4.32.0-windows/bin/lake.exe",
      "env",
      "C:/math/.skill-workspace/do-math-toolchains/lean-4.32.0/lean-4.32.0-windows/bin/lean.exe"
    ],
    "version_command": [
      "C:/math/.skill-workspace/do-math-toolchains/lean-4.32.0/lean-4.32.0-windows/bin/lake.exe",
      "env",
      "C:/math/.skill-workspace/do-math-toolchains/lean-4.32.0/lean-4.32.0-windows/bin/lean.exe",
      "--version"
    ],
    "cwd": "C:/math/.skill-workspace/do-math-toolchains/mathlib-4.32.0",
    "env": {},
    "cache_epoch": "initial",
    "allowed_axioms": [
      "propext",
      "Classical.choice",
      "Quot.sound"
    ]
  }
}
