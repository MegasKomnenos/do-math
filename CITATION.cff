    given-names: "Jaehyoung"
    affiliation: "Kyungpook National University"
repository-code: "https://github.com/MegasKomnenos/do-math"
url: "https://github.com/MegasKomnenos/do-math"
license: MPL-2.0
keywords:
  - "autonomous mathematical research"
  - "multi-agent system"
  - "large language models"
  - "Lean 4"
  - "parking functions"
  - "unimodality"
